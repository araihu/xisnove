{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xisnove.dev/schemas/release-candidate-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "commit", "version", "sourceDateEpoch", "subjects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"const": "github.com/araihu/xisnove"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "sourceDateEpoch": {"type": "integer", "minimum": 1},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "locator", "sha256", "size"],
        "properties": {
          "kind": {"enum": ["archive", "chart", "bundle", "sbom", "metadata", "oci-index", "oci-manifest", "oci-platform-manifest"]},
          "name": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "platform": {"type": "string", "pattern": "^linux/(?:amd64|arm64)$"},
          "mediaType": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
