[Unit]
Description=Xisnove outbound Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xisnove-agent
Group=xisnove-agent
UMask=0077
EnvironmentFile=/etc/xisnove/agent.env
Environment=XISNOVE_AGENT_CREDENTIAL_FILE=/var/lib/xisnove-agent/credential.json
ExecStart=/usr/bin/xisnove-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xisnove-agent
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
