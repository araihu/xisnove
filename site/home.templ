package site

// THESIS: Static control-room bulletin, not a generic monitoring landing page.
// OWN-WORLD: X-9 midnight, cobalt, paper, lime signal; rigid broadcast rows.
// STORY: Operators learn what X-9 observes, why external observation matters, and where to begin.
// FIRST VIEWPORT: Product mark and navigation frame a double-height promise; source link leads.
// FORM: Signal bulletin, candidate four, seed 147226ca; teletext structure fused with X-9 identity.
templ Page() {
	<!doctype html>
	<html lang="en" data-theme="araihu">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="X-9 is an external monitoring control plane for mixed homelab infrastructure."/>
			<meta name="theme-color" content="#07111f"/>
			<title>X-9 — External monitoring control plane</title>
			<link rel="icon" type="image/svg+xml" href="/assets/x9-icon.svg"/>
			<link rel="stylesheet" href="/assets/styles.css"/>
			<link rel="stylesheet" href="/assets/x9.css"/>
		</head>
		<body class="x9-site">
			<a class="x9-skip" href="#main-content">Skip to content</a>
			<header class="x9-header">
				<nav class="x9-shell x9-nav" aria-label="Primary navigation">
					<a class="x9-brand" href="/" aria-label="X-9 home">
						<img src="/assets/x9-logo.svg" alt="X-9" width="194" height="48"/>
					</a>
					<div class="x9-page-address" aria-label="Current page">X9 · 100</div>
					<a class="x9-nav-link" href="https://github.com/araihu/xisnove">
						<svg class="x9-nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/>
						</svg>
						<span>Source</span>
					</a>
				</nav>
			</header>
			<main id="main-content" tabindex="-1">
				<section class="x9-hero x9-shell" aria-labelledby="hero-title">
					<p class="x9-signal-label">External monitoring / operator control</p>
					<h1 id="hero-title">Observe from outside<br/>failure domain.</h1>
					<p class="x9-intro">X-9 is an API-first monitoring control plane for infrastructure spread across clusters, hosts, VPS nodes, DNS providers, and private networks.</p>
					<div class="x9-actions">
						<a class="x9-action x9-action--primary" href="https://github.com/araihu/xisnove">View source</a>
						<a class="x9-action" href="https://github.com/araihu/xisnove/tree/main/docs">Read documentation</a>
					</div>
					<div class="x9-mosaic" aria-hidden="true">
						<span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
					</div>
				</section>
				<section class="x9-board" aria-labelledby="board-title">
					<div class="x9-shell">
						<div class="x9-board-heading">
							<p class="x9-signal-label">X9 · 200</p>
							<h2 id="board-title">One control plane. Many observation points.</h2>
						</div>
						<ol class="x9-routes">
							<li><span class="x9-route-number">201</span><div><h3>Public endpoints</h3><p>Observe HTTP routes and DNS-backed services from an independent control plane.</p></div></li>
							<li><span class="x9-route-number">202</span><div><h3>Private networks</h3><p>Deploy agents near targets reachable only inside your homelab, cluster, or VPN.</p></div></li>
							<li><span class="x9-route-number">203</span><div><h3>Operator-reviewed discovery</h3><p>Discover Kubernetes resources under read-only RBAC; choose what becomes a monitor.</p></div></li>
							<li><span class="x9-route-number">204</span><div><h3>Evidence-led response</h3><p>Keep current state, freshness, and the next safe action close to the operator.</p></div></li>
						</ol>
					</div>
				</section>
				<section class="x9-closer x9-shell" aria-labelledby="closer-title">
					<p class="x9-signal-label">X9 · 300</p>
					<h2 id="closer-title">Infrastructure changes. Observation must remain independent.</h2>
					<a class="x9-action x9-action--primary" href="https://github.com/araihu/xisnove">Explore X-9</a>
				</section>
			</main>
			<footer class="x9-footer">
				<div class="x9-shell"><span>X-9 · self-hosted monitoring</span><a href="https://araihu.com">Arai Hû</a><span>© 2026</span></div>
			</footer>
		</body>
	</html>
}
