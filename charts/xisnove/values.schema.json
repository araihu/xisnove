{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "database": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "installationID", "migration", "sqlite", "postgres", "tursoManaged"],
      "properties": {
        "profile": {"type": "string", "enum": ["sqlite", "postgres", "tursoManaged"]},
        "installationID": {"type": "string", "minLength": 1},
        "migration": {"$ref": "#/definitions/job"},
        "sqlite": {"type": "object", "additionalProperties": false, "required": ["size", "storageClassName"], "properties": {"size": {"type": "string", "minLength": 1}, "storageClassName": {"type": "string"}}},
        "postgres": {"$ref": "#/definitions/databaseSecret"},
        "tursoManaged": {"type": "object", "additionalProperties": false, "required": ["existingSecret"], "properties": {"existingSecret": {"type": "object", "additionalProperties": false, "required": ["name", "urlKey", "authTokenKey"], "properties": {"name": {"type": "string"}, "urlKey": {"type": "string", "minLength": 1}, "authTokenKey": {"type": "string", "minLength": 1}}}}}
      }
    },
    "secrets": {
      "type": "object", "additionalProperties": false, "required": ["server", "admin", "ui"],
      "properties": {
        "server": {"type": "object", "additionalProperties": false, "required": ["existingSecret"], "properties": {"existingSecret": {"type": "object", "additionalProperties": false, "required": ["name", "cursorSigningKeyKey", "notificationMasterKeyKey"], "properties": {"name": {"type": "string", "minLength": 1}, "cursorSigningKeyKey": {"type": "string", "minLength": 1}, "notificationMasterKeyKey": {"type": "string", "minLength": 1}}}}},
        "admin": {"type": "object", "additionalProperties": false, "required": ["email", "existingSecret"], "properties": {"email": {"type": "string", "minLength": 3}, "existingSecret": {"type": "object", "additionalProperties": false, "required": ["name", "passwordKey"], "properties": {"name": {"type": "string", "minLength": 1}, "passwordKey": {"type": "string", "minLength": 1}}}}},
        "ui": {"type": "object", "additionalProperties": false, "required": ["existingSecret"], "properties": {"existingSecret": {"type": "object", "additionalProperties": false, "required": ["name", "cookieSecretKey"], "properties": {"name": {"type": "string", "minLength": 1}, "cookieSecretKey": {"type": "string", "minLength": 1}}}}}
      }
    },
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "image", "serviceAccount", "service", "resources", "podAnnotations", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1}, "image": {"$ref": "#/definitions/image"},
        "serviceAccount": {"$ref": "#/definitions/serviceAccount"}, "service": {"$ref": "#/definitions/service"},
        "resources": {"type": "object"}, "podAnnotations": {"type": "object"}, "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"}
      }
    },
    "ui": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "image", "serviceAccount", "service", "resources", "podAnnotations", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints", "cookieSecure"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1}, "image": {"$ref": "#/definitions/image"},
        "serviceAccount": {"$ref": "#/definitions/serviceAccount"}, "service": {"$ref": "#/definitions/service"},
        "resources": {"type": "object"}, "podAnnotations": {"type": "object"}, "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"},
        "cookieSecure": {"type": "boolean"}
      }
    },
    "bootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "activeDeadlineSeconds", "backoffLimit", "ttlSecondsAfterFinished", "timeout"],
      "properties": {"enabled": {"type": "boolean"}, "activeDeadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 10}, "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0}, "timeout": {"type": "string", "minLength": 2}}
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "replicas", "name", "image", "serviceAccount", "resources", "podAnnotations", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints", "existingSecret", "enrollment", "capabilities", "allowedPrivateCIDRs"], "properties": {
        "enabled": {"type": "boolean"}, "name": {"type": "string", "minLength": 1},
        "replicas": {"type": "integer", "const": 1}, "image": {"$ref": "#/definitions/image"}, "serviceAccount": {"$ref": "#/definitions/serviceAccount"},
        "resources": {"type": "object"}, "podAnnotations": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"},
        "existingSecret": {"type": "object", "additionalProperties": false, "required": ["name", "credentialKey"], "properties": {"name": {"type": "string", "minLength": 1}, "credentialKey": {"type": "string", "minLength": 1}}},
        "enrollment": {"type": "object", "additionalProperties": false, "required": ["enabled", "timeout", "existingSecret", "storage"], "properties": {
          "enabled": {"type": "boolean"}, "timeout": {"type": "string", "minLength": 2},
          "existingSecret": {"type": "object", "additionalProperties": false, "required": ["name", "tokenKey"], "properties": {"name": {"type": "string"}, "tokenKey": {"type": "string", "minLength": 1}}},
          "storage": {"type": "object", "additionalProperties": false, "required": ["size", "storageClassName"], "properties": {"size": {"type": "string", "minLength": 1}, "storageClassName": {"type": "string"}}}
        }},
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["http", "tcp", "dns"]}, "uniqueItems": true},
        "allowedPrivateCIDRs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ingress": {"type": "object", "additionalProperties": false, "required": ["enabled", "className", "host", "annotations", "tls"], "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}, "host": {"type": "string"}, "annotations": {"type": "object"}, "tls": {"type": "object", "additionalProperties": false, "required": ["enabled", "existingSecretName"], "properties": {"enabled": {"type": "boolean"}, "existingSecretName": {"type": "string"}}}}},
    "gateway": {"type": "object", "additionalProperties": false, "required": ["enabled", "parentRef", "hostnames"], "properties": {"enabled": {"type": "boolean"}, "parentRef": {"type": "object", "additionalProperties": false, "required": ["name", "namespace", "sectionName"], "properties": {"name": {"type": "string"}, "namespace": {"type": "string"}, "sectionName": {"type": "string"}}}, "hostnames": {"type": "array", "items": {"type": "string"}}}},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled", "ingressNamespaceSelector"], "properties": {"enabled": {"type": "boolean"}, "ingressNamespaceSelector": {"type": "object"}}},
    "pdb": {"type": "object", "additionalProperties": false, "required": ["enabled", "minAvailable"], "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": ["integer", "string"]}}},
    "serviceMonitor": {"type": "object", "additionalProperties": false, "required": ["enabled", "interval", "labels"], "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string", "minLength": 1}, "labels": {"type": "object"}}}
  },
  "allOf": [
    {"if": {"properties": {"database": {"properties": {"profile": {"const": "sqlite"}}}}}, "then": {"properties": {"server": {"properties": {"replicas": {"const": 1}}}}}},
    {"if": {"properties": {"database": {"properties": {"profile": {"const": "postgres"}}}}}, "then": {"properties": {"database": {"properties": {"postgres": {"properties": {"existingSecret": {"properties": {"name": {"minLength": 1}}}}}}}}}},
    {"if": {"properties": {"database": {"properties": {"profile": {"const": "tursoManaged"}}}}}, "then": {"properties": {"database": {"properties": {"tursoManaged": {"properties": {"existingSecret": {"properties": {"name": {"minLength": 1}}}}}}}}}},
    {"not": {"properties": {"ingress": {"properties": {"enabled": {"const": true}}}, "gateway": {"properties": {"enabled": {"const": true}}}}}}
  ],
  "definitions": {
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"}, "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}}},
    "serviceAccount": {"type": "object", "additionalProperties": false, "required": ["create", "name"], "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["type", "port"], "properties": {"type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "workload": {"type": "object", "required": ["replicas", "image", "serviceAccount", "resources", "podAnnotations", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints"], "properties": {"replicas": {"type": "integer", "minimum": 1}, "image": {"$ref": "#/definitions/image"}, "serviceAccount": {"$ref": "#/definitions/serviceAccount"}, "service": {"$ref": "#/definitions/service"}, "resources": {"type": "object"}, "podAnnotations": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"}}},
    "job": {"type": "object", "additionalProperties": false, "required": ["activeDeadlineSeconds", "backoffLimit", "ttlSecondsAfterFinished", "lockTimeout", "timeout"], "properties": {"activeDeadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 10}, "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0}, "lockTimeout": {"type": "string", "minLength": 2}, "timeout": {"type": "string", "minLength": 2}}},
    "databaseSecret": {"type": "object", "additionalProperties": false, "required": ["existingSecret"], "properties": {"existingSecret": {"type": "object", "additionalProperties": false, "required": ["name", "urlKey"], "properties": {"name": {"type": "string"}, "urlKey": {"type": "string", "minLength": 1}}}}}
  }
}
