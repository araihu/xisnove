package view

import (
	"github.com/araihu/goshtoso/components/alert"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/card"
	"github.com/araihu/goshtoso/components/head"
	"github.com/araihu/goshtoso/components/navbar"
	"github.com/araihu/goshtoso/components/textinput"
)

templ Document(title string, content templ.Component) {
	<!doctype html>
	<html lang="en" data-theme="goshtoso">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Xisnove</title>
			@head.Dependencies()
		</head>
		<body class="min-h-screen bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			@content
		</body>
	</html>
}

templ Brand() {
	<span class="text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Xisnove</span>
}

templ LoginPage(csrfToken, errorMessage string) {
	@Document("Sign in", LoginContent(csrfToken, errorMessage))
}

templ LoginContent(csrfToken, errorMessage string) {
	<main id="login-content" aria-labelledby="login-heading" class="mx-auto flex min-h-screen max-w-lg items-center px-6 py-12">
		<div class="w-full">
			<h1 id="login-heading" class="sr-only">Administrator sign in</h1>
			if errorMessage != "" {
				<div class="mb-6">
					@alert.Alert(alert.Config{
						Title: "Sign-in failed",
						Description: errorMessage,
						Tone: alert.ToneDanger,
					})
				</div>
			}
			@card.Card(card.Config{
				Title: "Administrator sign in",
				Description: "Use the local Xisnove administrator account. Credentials are sent only to this BFF.",
				Footer: LoginForm(csrfToken),
				RootClass: "max-w-none",
			})
			<p class="mt-6 text-center text-sm">
				<a class="font-medium text-primary underline-offset-2 hover:underline dark:text-primary-dark" href="/status">View public status</a>
			</p>
		</div>
	</main>
}

templ LoginForm(csrfToken string) {
	<form method="post" action="/login" class="flex w-full flex-col gap-4" autocomplete="on">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		@textinput.TextInput(textinput.Config{
			ID: "username",
			Name: "username",
			Label: "Administrator username",
			Type: textinput.TypeText,
			Autocomplete: "username",
			Required: true,
		})
		<div class="flex w-full flex-col gap-1 text-on-surface dark:text-on-surface-dark">
			<label class="w-fit pl-0.5 text-sm" for="password">Password</label>
			<input
				id="password"
				name="password"
				type="password"
				autocomplete="current-password"
				required
				class="w-full rounded-radius border border-outline bg-surface px-2 py-2 text-sm text-on-surface-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark"
			/>
		</div>
		@button.Button(
			button.WithType("submit"),
			button.WithTone(button.TonePrimary),
			button.WithRootClass("w-full"),
		) {
			Sign in
		}
	</form>
}

templ ShellPage(csrfToken string) {
	@Document("Overview", Shell(csrfToken))
}

templ Shell(csrfToken string) {
	@navbar.Navbar(navbar.Config{
		Brand: Brand(),
		BrandHref: "/",
		Links: []navbar.NavLink{
			{Label: "Overview", Href: "/", Active: true},
			{Label: "Public status", Href: "/status"},
		},
		Actions: []navbar.ActionItem{
			{Content: LogoutForm(csrfToken), Position: navbar.ActionRight},
		},
	})
	@DashboardContent()
}

templ LogoutForm(csrfToken string) {
	<form method="post" action="/logout">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		@button.Button(
			button.WithType("submit"),
			button.WithTone(button.ToneAlternate),
			button.WithSize(button.SizeSmall),
		) {
			Sign out
		}
	</form>
}

templ DashboardContent() {
	<main id="dashboard-content" class="mx-auto max-w-6xl px-6 py-10">
		<div class="mb-8">
			<p class="text-sm font-medium text-primary dark:text-primary-dark">Control plane</p>
			<h1 class="mt-2 text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Monitoring overview</h1>
			<p class="mt-3 max-w-2xl text-on-surface-muted dark:text-on-surface-dark-muted">The UI foundation is ready. Live monitor and incident data will arrive through the frozen generated SDK adapter.</p>
		</div>
		<div class="grid gap-6 md:grid-cols-2">
			@card.Card(card.Config{
				Tag: "Foundation",
				Title: "Secure BFF session",
				Description: "The opaque control-plane credential remains in a Secure, HttpOnly, SameSite cookie and never enters browser JavaScript.",
				RootClass: "max-w-none",
			})
			@card.Card(card.Config{
				Tag: "Contract handoff",
				Title: "SDK adapter pending",
				Description: "No endpoint or API model is duplicated here. This shell will consume the generated SDK after the frozen mock contract is published.",
				RootClass: "max-w-none",
			})
		</div>
	</main>
}

templ StatusPage() {
	@Document("Public status", PublicStatusShell())
}

templ PublicStatusShell() {
	@navbar.Navbar(navbar.Config{
		Brand: Brand(),
		BrandHref: "/status",
		Links: []navbar.NavLink{
			{Label: "Public status", Href: "/status", Active: true},
			{Label: "Administrator", Href: "/login"},
		},
	})
	@StatusContent()
}

templ StatusContent() {
	<main id="status-content" aria-live="polite" class="mx-auto max-w-4xl px-6 py-12">
		<p class="text-sm font-medium text-primary dark:text-primary-dark">Public status</p>
		<h1 class="mt-2 text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Xisnove status</h1>
		<div class="mt-8">
			@alert.Alert(alert.Config{
				Title: "Status surface ready",
				Description: "The public shell is available. Live service health will be rendered after the generated SDK and contract mock are handed off.",
				Tone: alert.ToneInfo,
			})
		</div>
	</main>
}

type Problem struct {
	Title string
	Detail string
	Code string
	CorrelationID string
}

templ ProblemPage(problem Problem) {
	@Document(problem.Title, ProblemContent(problem))
}

templ ProblemContent(problem Problem) {
	<main id="problem-content" class="mx-auto max-w-3xl px-6 py-12">
		@alert.Alert(alert.Config{
			Title: problem.Title,
			Description: problem.Detail,
			Tone: alert.ToneDanger,
		})
		<div class="mt-6 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
			<p>Error code: <code>{ problem.Code }</code></p>
			<p>Correlation ID: <code>{ problem.CorrelationID }</code></p>
		</div>
	</main>
}
