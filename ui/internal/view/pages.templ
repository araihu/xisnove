package view

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/araihu/goshtoso/components/alert"
	"github.com/araihu/goshtoso/components/avatar"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/card"
	"github.com/araihu/goshtoso/components/drawer"
	"github.com/araihu/goshtoso/components/dropdown"
	"github.com/araihu/goshtoso/components/emptystate"
	"github.com/araihu/goshtoso/components/head"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/navbar"
	"github.com/araihu/goshtoso/components/pageheader"
	"github.com/araihu/goshtoso/components/skeleton"
	"github.com/araihu/goshtoso/components/table"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/xisnove/sdk"
)

type MonitorList struct {
	Monitors []sdk.Monitor
	Health map[string]sdk.MonitorHealth
	Cursor string
	NextCursor string
	Query string
	Selected string
	HealthFailures int
	SearchPages int
}

type Problem struct {
	Title string
	Detail string
	Code string
	CorrelationID string
	RetryURL string
}

type GlobalSearchData struct {
	Query string
	Items []sdk.SearchResult
	Error string
}

templ Document(title string, content templ.Component) {
	<!doctype html>
	<html lang="en" data-theme="araihu" x-data="{ theme: localStorage.getItem('xisnove-theme') || 'araihu', dark: localStorage.getItem('xisnove-mode') === 'dark' }" x-init="$el.dataset.theme = theme; localStorage.setItem('xisnove-theme', theme); $el.classList.toggle('dark', dark)">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · X-9</title>
			<link rel="icon" type="image/svg+xml" href="/ui/xisnove-ab01f1a.svg"/>
			@head.Dependencies()
			<link rel="stylesheet" href="/ui/araihu-f841fe90.css"/>
			@ApplicationScript()
			@AppStyles()
		</head>
		<body>
			@content
		</body>
	</html>
}

templ ApplicationScript() {
	<script src="/ui/app.js" defer nonce={ templ.GetNonce(ctx) }></script>
}

templ AppStyles() {
	<style>
		:root { --xis-gap: 1rem; --xis-action-bg: var(--color-primary); --xis-action-fg: var(--color-on-primary); --xis-link: var(--color-primary); --xis-control-outline: var(--color-outline-strong, var(--color-outline)); }
		.dark { --xis-action-bg: var(--color-primary-dark); --xis-action-fg: var(--color-on-primary-dark); --xis-link: var(--color-primary-dark); --xis-control-outline: var(--color-outline-dark-strong); }
		body { margin: 0; background: var(--color-surface); color: var(--color-on-surface); }
		html.console-shell-root { overflow-x: hidden; }
		body.console-shell { overflow-x: hidden; }
		main.console-shell__main { overflow-x: hidden; }
		.console-shell__content { overflow-x: clip; }
		.console-shell-root.js .console-shell__sidebar:not(.is-open) { visibility: hidden; pointer-events: none; }
		.console-shell-root.js .console-shell__sidebar.is-open { visibility: visible; pointer-events: auto; }
		html.dark .console-shell__sidebar [data-consoleshell-nav-id][aria-current="page"] { color: var(--color-primary-dark); }
		@media (min-width: 720px) { .console-shell-root.js .console-shell__sidebar { visibility: visible; pointer-events: auto; } }
		.dark body { background: var(--color-surface-dark); color: var(--color-on-surface-dark); }
		.xis-brand { display: inline-flex; align-items: center; flex: 0 0 auto; min-width: 2.75rem; min-height: 2.75rem; color: var(--color-on-surface-strong); }
		.dark .xis-brand { color: var(--color-on-surface-dark-strong); }
		.xis-brand-logo { display: block; width: 7.5rem; height: 2rem; }
		.xis-brand-mark, .xis-brand-mark-reverse { display: none; width: 2.25rem; height: 2.25rem; }
		.dark .xis-brand-logo, .dark .xis-brand-mark { display: none; }
		.dark .xis-brand-mark-reverse { display: block; }
		.xis-content { width: 100%; max-width: 80rem; margin-inline: auto; padding: 2rem 1rem 4rem; overflow-x: clip; }
		.xis-stack { display: grid; gap: var(--xis-gap); }
		.xis-field { display: grid; gap: .25rem; font-size: .875rem; }
		.xis-input { min-height: 3rem; min-width: 0; max-width: 100%; border: 1px solid var(--xis-control-outline); border-radius: .5rem; background: var(--color-surface); color: var(--color-on-surface-strong); padding: .5rem .75rem; }
		.xis-login-form input:not([type="hidden"]) { min-height: 3rem; }
		.dark .xis-input { background: var(--color-surface-dark-alt); color: var(--color-on-surface-dark-strong); }
		.xis-input:focus-visible, .xis-native-link:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
		a[href]:focus-visible { outline: 3px solid currentColor !important; outline-offset: 2px !important; }
		button:focus-visible { outline: 3px solid var(--color-primary) !important; outline-offset: 2px !important; }
		.dark button:focus-visible { outline-color: var(--color-primary-dark) !important; }
		.xis-native-link, .xis-action-link { color: var(--xis-link); display: inline-flex; align-items: center; min-width: 2.75rem; min-height: 2.75rem; }
		.xis-action-link { justify-content: center; }
		.xis-visual-test *, .xis-visual-test *::before, .xis-visual-test *::after { transition: none; animation: none; }
		.xis-public-nav a:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; box-shadow: 0 0 0 3px var(--color-surface); }
		.dark .xis-public-nav a:focus-visible { outline-color: var(--color-primary-dark); box-shadow: 0 0 0 3px var(--color-surface-dark); }
		.xis-primary-action { background: var(--xis-action-bg); border-color: var(--xis-action-bg); color: var(--xis-action-fg); }
		button.xis-primary-action:focus, button.xis-primary-action:focus-visible, a.xis-primary-action:focus, a.xis-primary-action:focus-visible { outline: 3px solid var(--color-primary) !important; outline-offset: 2px !important; box-shadow: 0 0 0 3px var(--color-primary) !important; }
		.dark button.xis-primary-action:focus, .dark button.xis-primary-action:focus-visible, .dark a.xis-primary-action:focus, .dark a.xis-primary-action:focus-visible { outline-color: var(--color-primary-dark) !important; box-shadow: 0 0 0 3px var(--color-primary-dark) !important; }
		.xis-primary-action { min-width: 2.75rem; min-height: 2.75rem; }
		button { min-width: 2.75rem; min-height: 2.75rem; }
		.xis-recovery-action { border: 1px solid var(--xis-action-bg); border-radius: .5rem; padding: .5rem .75rem; font: inherit; cursor: pointer; }
		.xis-results { display: grid; gap: 1rem; min-width: 0; max-width: 100%; min-height: 16rem; }
		.xis-results-surface { width: 100%; min-width: 0; min-height: 16rem; }
		.xis-results.xis-results-surface { width: min(100%, calc(100vw - 4.5rem)); max-width: 100%; }
		.xis-table-scroll { width: 100%; max-width: 100%; min-width: 0; overflow-x: auto; contain: paint; }
		.xis-table-scroll table { min-width: 48rem; }
		.xis-meta { color: var(--color-on-surface-muted); font-size: .875rem; }
		.dark .xis-meta { color: var(--color-on-surface-dark-muted); }
		.xis-public-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-outline); }
		.dark .xis-public-row { border-color: var(--color-outline-dark-strong); }
		.xis-status-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
		.xis-status-results { align-content: start; align-items: start; min-height: 0; }
		.xis-monitor-drawer-panel { top: 4rem !important; }
		.xis-monitor-drawer > div > div:first-child { z-index: 55 !important; }
		.xis-monitor-drawer-panel { z-index: 60 !important; }
		.xis-monitor-drawer-panel #monitor-detail-drawer-body { padding: 1.25rem 1.5rem 2rem; }
		.xis-detail-workspace { display: grid; grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr); gap: 2rem; }
		.xis-detail-main, .xis-detail-rail, .xis-detail-section { display: grid; align-content: start; gap: .75rem; min-width: 0; }
		.xis-detail-identity { display: flex; align-items: start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
		.xis-detail-rail { border-left: 1px solid var(--color-outline); padding-left: 1.5rem; }
		.dark .xis-detail-rail { border-color: var(--color-outline-dark-strong); }
		.xis-detail-facts { display: grid; grid-template-columns: minmax(8rem, auto) minmax(0, 1fr); gap: .5rem 1rem; margin: 0; }
		.xis-detail-facts dt { color: var(--color-on-surface-muted); }
		.dark .xis-detail-facts dt { color: var(--color-on-surface-dark-muted); }
		.xis-detail-facts dd { margin: 0; overflow-wrap: anywhere; }
		.xis-availability { border: 1px solid var(--color-outline); border-radius: .75rem; padding: 1rem; background: var(--color-surface-alt); }
		.dark .xis-availability { border-color: var(--color-outline-dark-strong); background: var(--color-surface-dark-alt); }
		.xis-availability-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
		.xis-availability-heading h3 { margin: 0; }
		.xis-availability-heading p { margin: .25rem 0 0; }
		.xis-availability-chart { margin: .25rem 0 0; width: 100%; }
		.xis-availability-chart figcaption { margin-top: .25rem; }
		.xis-password { width: 100%; }
		.xis-skeleton { display: none; width: 100%; min-height: 16rem; }
		.xis-skeleton.htmx-request, .htmx-request .xis-skeleton { display: block; }
		#monitor-loading.htmx-request ~ .xis-results, #status-loading.htmx-request ~ .xis-status-results { display: none; }
		.xis-state-info { color: var(--color-info-text); }
		.xis-state-warning { color: var(--color-warning-text); }
		.xis-state-success { color: var(--color-success-text); }
		.xis-state-danger { color: var(--color-danger-text); }
		.xis-state-info *, .xis-state-warning *, .xis-state-success *, .xis-state-danger * { color: inherit; }
		.dark .xis-state-info { color: var(--color-info-text-dark); }
		.dark .xis-state-warning { color: var(--color-warning-text-dark); }
		.dark .xis-state-success { color: var(--color-success-text-dark); }
		.dark .xis-state-danger { color: var(--color-danger-text-dark); }
		tr[aria-selected="true"] { background: var(--color-surface-alt); box-shadow: inset .25rem 0 0 var(--color-primary); }
		.dark tr[aria-selected="true"] { background: var(--color-surface-dark-alt); box-shadow: inset .25rem 0 0 var(--color-primary-dark); }
		.console-shell__header-inner { min-width: 0; }
		.console-shell-root .console-shell__menu { display: inline-flex; width: 3.25rem; height: 3.25rem; flex: 0 0 auto; align-items: center; justify-content: center; border: 1px solid var(--color-outline-strong); border-radius: var(--radius-radius, .5rem); background: transparent; color: var(--color-on-surface-strong); font-size: 0; line-height: 0; padding: 0; background-image: linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor), linear-gradient(currentColor, currentColor); background-position: center 34%, center 50%, center 66%; background-repeat: no-repeat; background-size: 1.35rem 2px; }
		.console-shell-root .console-shell__menu:hover { background-color: var(--color-surface-alt); }
		html.dark .console-shell__menu { border-color: var(--color-outline-dark-strong); color: var(--color-on-surface-dark-strong); }
		html.dark .console-shell__menu:hover { background-color: var(--color-surface-dark-alt); }
		.console-shell-root .console-shell__menu:focus-visible { outline: 3px solid currentColor; outline-offset: 2px; }
		.console-shell__brand { min-width: 0; }
		.console-shell__brand-name { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
		.console-shell__actions { min-width: 0; gap: .75rem; }
		.xis-global-search-trigger { flex: 1 1 28rem; min-width: 10rem; margin-left: 0; }
		.xis-global-search-trigger > div { width: 100%; min-width: 0; }
		.xis-global-search-trigger button.xis-search-trigger-button { width: 100%; min-width: 0; min-height: 3.25rem; display: flex; align-items: center; justify-content: flex-start; gap: .625rem; border: 1px solid var(--color-outline-strong); border-radius: var(--radius-radius, .5rem); background: transparent; color: var(--color-on-surface); box-shadow: none; padding: .5rem .75rem; text-align: left; }
		.xis-global-search-trigger button.xis-search-trigger-button:hover { background: var(--color-surface-alt); border-color: var(--color-outline-strong); }
		.dark .xis-global-search-trigger button.xis-search-trigger-button { border-color: var(--color-outline-dark-strong); color: var(--color-on-surface-dark); }
		.dark .xis-global-search-trigger button.xis-search-trigger-button:hover { background: var(--color-surface-dark-alt); border-color: var(--color-outline-dark-strong); }
		.xis-global-search-trigger button.xis-search-trigger-button > span { display: inline-flex; min-width: 0; align-items: center; }
		.xis-global-search-trigger kbd { margin-left: auto; border: 1px solid var(--color-outline-strong); border-radius: .375rem; padding: .25rem .5rem; font-size: .8rem; line-height: 1; white-space: nowrap; }
		.dark .xis-global-search-trigger kbd { border-color: var(--color-outline-dark-strong); }
		.xis-dark-mode-toggle { display: inline-flex; width: 3rem; height: 3rem; flex: 0 0 auto; align-items: center; justify-content: center; border: 1px solid var(--color-outline-strong); border-radius: var(--radius-radius, .5rem); background: transparent; color: var(--color-on-surface-strong); cursor: pointer; }
		.xis-dark-mode-toggle:hover { background: var(--color-surface-alt); }
		.dark .xis-dark-mode-toggle { border-color: var(--color-outline-dark-strong); color: var(--color-on-surface-dark-strong); }
		.dark .xis-dark-mode-toggle:hover { background: var(--color-surface-dark-alt); }
		.xis-console-sidebar-header { display: grid; gap: .75rem; padding: 1rem; border-bottom: 1px solid var(--color-outline); }
		.dark .xis-console-sidebar-header { border-color: var(--color-outline-dark); }
		.xis-console-sidebar-header .console-shell__status-link { min-height: 2.75rem; }
		.xis-account-menu { flex: 0 0 auto; }
		.xis-account-menu > div > button[aria-haspopup="true"], .dark .xis-account-menu > div > button[aria-haspopup="true"] { min-width: 2.75rem; min-height: 2.75rem; padding: 0; border: 0; border-radius: 9999px; background: transparent; box-shadow: none; }
		.xis-account-menu > div > button[aria-haspopup="true"]:hover, .dark .xis-account-menu > div > button[aria-haspopup="true"]:hover { background: transparent; opacity: 1; }
		.xis-account-avatar { border-color: var(--color-on-surface-strong); background: var(--color-surface); color: var(--color-on-surface-strong); }
		.dark .xis-account-avatar { border-color: var(--color-on-surface-dark-strong); background: var(--color-surface-dark); color: var(--color-on-surface-dark-strong); }
		.xis-account-menu [role="menu"] { z-index: 70; }
		.xis-account-logout-form { display: none; }
		.xis-global-search-dialog { width: min(42rem, calc(100vw - 2rem)); max-height: min(38rem, calc(100vh - 5rem)); margin: 4.5rem auto auto; padding: 0; border: 0; border-radius: .75rem; color: var(--color-on-surface); background: var(--color-surface); box-shadow: 0 .75rem 2.5rem rgba(0, 0, 0, .28); overflow: hidden; }
		.xis-global-search-dialog::backdrop { background: rgba(2, 6, 23, .62); }
		.dark .xis-global-search-dialog { color: var(--color-on-surface-dark); background: var(--color-surface-dark-alt); }
		.xis-global-search-panel { display: grid; min-height: 18rem; grid-template-rows: auto minmax(0, 1fr) auto; }
		.xis-global-search-input-row { display: flex; align-items: center; gap: .75rem; padding: .875rem 1rem; border-bottom: 1px solid var(--color-outline); }
		.dark .xis-global-search-input-row { border-color: var(--color-outline-dark-strong); }
		.xis-global-search-input-row > svg { color: var(--color-on-surface-muted); }
		.dark .xis-global-search-input-row > svg { color: var(--color-on-surface-dark-muted); }
		.xis-global-search-input { flex: 1; min-width: 0; min-height: 2.75rem; border: 0; background: transparent; color: inherit; font: inherit; font-size: 1.05rem; }
		.xis-global-search-input:focus { outline: 0; }
		.xis-global-search-close { display: inline-flex; min-width: 3.25rem; min-height: 2.75rem; align-items: center; justify-content: center; gap: .35rem; border: 0; background: transparent; color: inherit; cursor: pointer; font: inherit; }
		.xis-global-search-close > span { font-size: 1.5rem; line-height: 1; }
		.xis-global-search-close kbd { border: 1px solid var(--color-outline-strong); border-radius: .375rem; padding: .25rem .45rem; font-size: .75rem; line-height: 1; }
		.dark .xis-global-search-close kbd { border-color: var(--color-outline-dark-strong); }
		.xis-global-search-results { overflow-y: auto; padding: .5rem; }
		.xis-global-search-result { display: grid; gap: .2rem; padding: .75rem; border-radius: .5rem; color: inherit; text-decoration: none; }
		.xis-global-search-result:hover, .xis-global-search-result[aria-selected="true"] { background: var(--color-surface-alt); }
		.dark .xis-global-search-result:hover, .dark .xis-global-search-result[aria-selected="true"] { background: var(--color-surface-dark); }
		.xis-global-search-result-line { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
		.xis-global-search-state { display: grid; place-content: center; min-height: 12rem; padding: 1.5rem; text-align: center; color: var(--color-on-surface-muted); }
		.dark .xis-global-search-state { color: var(--color-on-surface-dark-muted); }
		.xis-global-search-footer { display: flex; justify-content: space-between; gap: 1rem; padding: .65rem 1rem; border-top: 1px solid var(--color-outline); font-size: .75rem; color: var(--color-on-surface-muted); }
		.dark .xis-global-search-footer { border-color: var(--color-outline-dark-strong); color: var(--color-on-surface-dark-muted); }
		@media (min-width: 720px) { .console-shell-root .console-shell__menu { display: none; } }
		@media (max-width: 719px) {
			.xis-content { padding: 1.25rem .75rem 3rem; }
			.console-shell__header-inner { gap: .5rem; padding-inline: .75rem; }
			.console-shell__brand-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.console-shell__actions { flex: 1 1 auto; gap: .35rem; margin-left: 0; }
			.xis-global-search-trigger { flex: 1 1 auto; min-width: 0; }
			.xis-global-search-trigger button.xis-search-trigger-button { min-height: 2.75rem; padding: .5rem .625rem; gap: .35rem; }
			.xis-global-search-trigger button.xis-search-trigger-button > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.xis-global-search-trigger kbd { padding: .2rem .35rem; font-size: .7rem; }
			.xis-global-search-dialog { width: calc(100vw - 1rem); margin-top: 4.25rem; }
			.xis-monitor-drawer-panel #monitor-detail-drawer-body { padding: 1rem .875rem 2rem; }
			.xis-public-row, .xis-detail-workspace { grid-template-columns: 1fr; }
			.xis-detail-rail { border-left: 0; border-top: 1px solid var(--color-outline); padding: 1.25rem 0 0; }
			.dark .xis-detail-rail { border-color: var(--color-outline-dark-strong); }
		}
		@media (max-width: 479px) { .console-shell__brand-name { display: none; } }
	</style>
}

templ Brand() {
	<span class="xis-brand" aria-label="Xisnove">
		<span class="sr-only">Xisnove</span>
		<img class="xis-brand-logo" src="/ui/xisnove-logo-ab01f1a.svg" alt="" width="120" height="32"/>
		<img class="xis-brand-mark" src="/ui/xisnove-mark-ab01f1a.svg" alt="" width="36" height="36"/>
		<img class="xis-brand-mark-reverse" src="/ui/xisnove-mark-reverse-ab01f1a.svg" alt="" width="36" height="36"/>
	</span>
}

templ DarkModeToggle() {
	<button type="button" class="xis-dark-mode-toggle" aria-label="Switch to dark mode" aria-pressed="false" x-data="{ dark: document.documentElement.classList.contains('dark') }" x-bind:aria-label="dark ? 'Switch to light mode' : 'Switch to dark mode'" x-bind:aria-pressed="dark" x-init="$watch('dark', value => { document.documentElement.classList.toggle('dark', value); localStorage.setItem('goshtoso-dark', String(value)); localStorage.setItem('xisnove-mode', value ? 'dark' : 'light'); window.dispatchEvent(new CustomEvent('xisnove-mode-change', { detail: { dark: value } })) })" x-on:click="dark = !dark">
		<span x-show="!dark">@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidSun, Size: icon.SizeLG, Decorative: true})</span>
		<span x-show="dark">@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidMoon, Size: icon.SizeLG, Decorative: true})</span>
	</button>
}

templ LoginPage(csrfToken, errorMessage string) { @Document("Sign in", LoginContent(csrfToken, errorMessage)) }

templ LoginContent(csrfToken, errorMessage string) {
	<main id="login-content" aria-labelledby="login-heading" class="xis-content">
		<div class="xis-stack" style="max-width:32rem;margin:8vh auto 0">
			<h1 id="login-heading" class="sr-only">Administrator sign in</h1>
			if errorMessage != "" {
				@alert.Alert(alert.Config{Title: "Sign-in failed", Description: errorMessage, Tone: alert.ToneDanger, RootClass: "xis-state-danger"})
			}
			@card.Card(card.Config{Title: "Administrator sign in", Description: "Use the local X-9 administrator account. Credentials are sent only to this BFF.", Footer: LoginForm(csrfToken), RootClass: "max-w-none"})
			<a class="xis-native-link" href="/status">View public status</a>
		</div>
	</main>
}

templ LoginForm(csrfToken string) {
	<form method="post" action="/login" class="xis-stack xis-login-form" autocomplete="on">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		@textinput.TextInput(textinput.Config{ID: "email", Name: "email", Label: "Administrator email", Type: textinput.TypeEmail, Autocomplete: "username", Required: true})
		<label class="xis-field" for="password">Password
			<input id="password" name="password" type="password" autocomplete="current-password" required class="xis-input xis-password"/>
		</label>
		@button.Button(button.WithType("submit"), button.WithTone(button.TonePrimary), button.WithRootClass("w-full xis-primary-action")) { Sign in }
	</form>
}

templ LogoutForm(csrfToken string) {
	<form id="xis-account-logout-form" class="xis-account-logout-form" method="post" action="/logout">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<button type="submit" hidden aria-hidden="true"></button>
	</form>
}

templ AccountMenu(csrfToken string) {
	<div class="xis-account-menu">
		@dropdown.Dropdown(dropdown.Config{
			ID: "account-menu",
			Label: "Account menu",
			TriggerIcon: avatar.Avatar(avatar.Config{Initials: "X9", Alt: "X-9 account", Size: avatar.SizeSM, Tone: avatar.ToneDefault, Shape: avatar.ShapeCircle, RootClass: "xis-account-avatar"}),
			TriggerIconOnly: true,
			MenuAlign: dropdown.AlignEnd,
			Sections: []dropdown.Section{{Items: []dropdown.Item{{Label: "Sign out", OnClick: "document.getElementById('xis-account-logout-form').requestSubmit()"}}}},
		})
		@LogoutForm(csrfToken)
	</div>
}

templ ShellPage(title, csrfToken string, content templ.Component) { @ConsolePage(title, csrfToken, content) }

templ ConsoleSidebarHeader() {
	<div class="xis-console-sidebar-header">
		<a class="xis-native-link console-shell__status-link" href="/status">Public status</a>
	</div>
}

templ ConsoleHeaderActions(csrfToken string) {
	@GlobalSearchTrigger()
	@DarkModeToggle()
	@AccountMenu(csrfToken)
}

templ GlobalSearchTrigger() {
	<div class="xis-global-search-trigger">
		<div id="global-search">
			@button.Button(
				button.WithType("button"),
				button.WithTone(button.ToneAlternate),
				button.WithRootClass("min-h-11 xis-search-trigger-button"),
				button.WithAttrs(templ.Attributes{"aria-haspopup": "dialog", "aria-controls": "global-search-dialog", "aria-expanded": "false"}),
			) {
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidMagnifyingGlass, Size: icon.SizeLG, Decorative: true, RootClass: "shrink-0"})
				<span>Search X-9</span><kbd>⌘ K</kbd>
			}
		</div>
	</div>
}

templ GlobalSearchModal() {
	<dialog id="global-search-dialog" class="xis-global-search-dialog" aria-modal="true" aria-labelledby="global-search-label">
		<div class="xis-global-search-panel">
			<div class="xis-global-search-input-row">
				<label id="global-search-label" class="sr-only" for="global-search-input">Search X-9</label>
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidMagnifyingGlass, Size: icon.SizeLG, Decorative: true, RootClass: "shrink-0"})
				<input id="global-search-input" class="xis-global-search-input" type="search" placeholder="Search monitors" autocomplete="off" spellcheck="false" minlength="2" maxlength="120" aria-controls="global-search-results" aria-autocomplete="list"/>
				<button type="button" class="xis-global-search-close" data-search-close aria-label="Close search"><span aria-hidden="true">×</span><kbd>Esc</kbd></button>
			</div>
			<div id="global-search-results" class="xis-global-search-results" role="listbox" aria-label="Search X-9 results" aria-live="polite">
				@GlobalSearchPrompt()
			</div>
			<div class="xis-global-search-footer"><span>↑↓ Navigate · Enter Open</span><span>Esc Close</span></div>
		</div>
	</dialog>
}

templ GlobalSearchPrompt() {
	<div class="xis-global-search-state" data-search-state="prompt"><p>Type at least 2 characters to search the control plane.</p></div>
}

templ GlobalSearchResults(data GlobalSearchData) {
	if data.Error != "" {
		<div class="xis-global-search-state xis-state-danger" data-search-state="error"><p>{ data.Error }</p><button type="button" class="xis-recovery-action" data-search-retry>Retry search</button></div>
	} else if len(data.Items) == 0 {
		<div class="xis-global-search-state" data-search-state="empty"><p>No control-plane resources match <strong>{ data.Query }</strong>.</p><p>Edit the query or close search.</p></div>
	} else {
		for _, item := range data.Items {
			<a id={ "global-search-result-" + item.ResourceId.String() } class="xis-global-search-result" role="option" aria-selected="false" tabindex="0" href={ templ.SafeURL(searchResultURL(item)) } hx-get={ searchResultURL(item) } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">
				<span class="xis-global-search-result-line"><strong>{ item.Title }</strong><span class="xis-meta">{ item.Context }</span></span>
				<span class="xis-meta">{ item.Description }</span>
			</a>
		}
	}
}

templ MonitorPage(csrfToken string, data MonitorList) { @ShellPage("Monitors", csrfToken, MonitorContent(data)) }

templ MonitorErrorPage(csrfToken string, problem Problem) { @ShellPage("Monitors", csrfToken, MonitorErrorContent(problem)) }

templ MonitorErrorContent(problem Problem) {
	<section id="monitor-content" class="xis-content xis-stack" aria-labelledby="monitor-heading">
		@pageheader.PageHeader(pageheader.Config{Title: "Monitors", Description: "Monitor inventory and current health.", TitleAttrs: templ.Attributes{"id": "monitor-heading"}})
		@alert.Alert(alert.Config{Title: problem.Title, Description: problem.Detail, Tone: alert.ToneDanger, RootClass: "xis-state-danger"})
		<a class="xis-native-link" href={ templ.SafeURL(problem.RetryURL) } hx-get={ problem.RetryURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Retry</a>
	</section>
}

templ MonitorContent(data MonitorList) {
	<section id="monitor-content" class="xis-content xis-stack" aria-labelledby="monitor-heading">
		@pageheader.PageHeader(pageheader.Config{Title: "Monitors", TitleAttrs: templ.Attributes{"id": "monitor-heading"}})
		<div id="monitor-loading" class="htmx-indicator xis-search-indicator xis-skeleton xis-results-surface" aria-live="polite">
			@skeleton.Skeleton(skeleton.Config{Shape: skeleton.ShapeRectangle, Count: 1, Label: "Loading monitors", RootClass: "min-h-64"})
		</div>
		<div id="monitor-results" class="xis-results xis-results-surface" aria-live="polite" aria-busy="false">
			if data.HealthFailures > 0 {
				@alert.Alert(alert.Config{Title: "Some health is unavailable", Description: fmt.Sprintf("%d monitor health result(s) could not be loaded. Available monitors remain usable and unknown states are shown explicitly.", data.HealthFailures), Tone: alert.ToneWarning, RootClass: "xis-state-warning"})
			}
			if len(data.Monitors) == 0 {
				if data.Query != "" {
					@emptystate.EmptyState(emptystate.Config{Title: "No matching monitors", Description: "No monitor matches the active search. Clear the search to return to the complete list.", Action: ClearSearch()})
				} else {
					@emptystate.EmptyState(emptystate.Config{Title: "No monitors yet", Description: "Create a monitor through the API or CLI; it will appear here on the next refresh."})
				}
			} else {
				<div class="xis-table-scroll">@table.Table(monitorTable(data))</div>
			}
			if data.NextCursor != "" {
				@NextPage(data)
			}
			if data.Selected != "" {
				if monitor, health, ok := selectedMonitor(data); ok {
					@MonitorDetailDrawer(data, monitor, health)
				} else {
					@alert.Alert(alert.Config{Title: "Selected monitor unavailable", Description: "The selected monitor is not present in this result page. The monitor list remains available; close the detail or select a visible row.", Tone: alert.ToneWarning, RootClass: "xis-state-warning", Link: &alert.LinkConfig{Label: "Close detail", Href: monitorURL(data.Query, data.Cursor, "")}})
				}
			}
		</div>
	</section>
}

templ MonitorDetailDrawer(data MonitorList, monitor sdk.Monitor, health sdk.MonitorHealth) {
	<div
		class="xis-monitor-drawer"
		data-monitor-id={ monitor.Id.String() }
		x-data="{}"
		x-on:drawer:close-request.window="if ($event.detail && $event.detail.id === 'monitor-detail-drawer') { $event.preventDefault(); document.getElementById('monitor-detail-close')?.click() }"
	>
		@drawer.Drawer(drawer.Config{ID: "monitor-detail-drawer", Title: "Monitor detail", Side: drawer.SideRight, Width: drawer.WidthXL, BodyID: "monitor-detail-drawer-body", PanelClass: "xis-monitor-drawer-panel"}) {
			@MonitorDetail(data, monitor, health)
		}
	</div>
}

templ MonitorDetail(data MonitorList, monitor sdk.Monitor, health sdk.MonitorHealth) {
	<section id="monitor-detail" class="xis-detail-workspace" aria-labelledby="monitor-detail-heading" data-monitor-id={ monitor.Id.String() } data-monitor-state={ string(health.State) } data-monitor-updated={ monitor.UpdatedAt.UTC().Format(time.RFC3339) }>
		<div class="xis-detail-main">
			<div class="xis-detail-identity">
				<div>
					<p class="xis-meta">Selected monitor</p>
					<h3 id="monitor-detail-heading" tabindex="-1" data-autofocus>{ monitor.Name }</h3>
					<p class="xis-meta"><code>{ monitor.Id.String() }</code></p>
				</div>
				@healthBadge(health.State)
			</div>
			<section class="xis-detail-section" aria-labelledby="monitor-health-heading">
				<h3 id="monitor-health-heading">Current health</h3>
				<p>{ monitor.Description }</p>
				<dl class="xis-detail-facts">
					<dt>State</dt><dd>{ strings.ToUpper(string(health.State)) }</dd>
					<dt>Last transition</dt><dd>{ formattedTime(health.LastTransitionAt) }</dd>
					<dt>Locations observed</dt><dd>{ fmt.Sprintf("%d", len(health.Locations)) }</dd>
				</dl>
			</section>
			<section class="xis-detail-section" aria-labelledby="monitor-configuration-heading">
				<h3 id="monitor-configuration-heading">Configuration</h3>
				<dl class="xis-detail-facts">
					<dt>Kind</dt><dd>{ strings.ToUpper(string(monitor.Kind)) }</dd>
					<dt>Interval</dt><dd>{ fmt.Sprintf("%d seconds", monitor.IntervalSeconds) }</dd>
					<dt>Timeout</dt><dd>{ fmt.Sprintf("%d ms", monitor.TimeoutMillis) }</dd>
					<dt>Open after</dt><dd>{ fmt.Sprintf("%d failures", monitor.FailureThreshold) }</dd>
					<dt>Recover after</dt><dd>{ fmt.Sprintf("%d successes", monitor.RecoveryThreshold) }</dd>
				</dl>
			</section>
			<section class="xis-detail-section xis-availability" aria-labelledby="monitor-availability-heading">
				<div class="xis-availability-heading">
					<div>
						<h3 id="monitor-availability-heading">Live availability</h3>
						<p class="xis-meta">Probe state stream, last 24 samples.</p>
					</div>
					@healthBadge(health.State)
				</div>
				@monitorAvailabilityChart(monitor, health)
			</section>
		</div>
		<aside class="xis-detail-rail" aria-label="Monitor metadata and actions">
			<h3>Monitor metadata</h3>
			<dl class="xis-detail-facts">
				<dt>Enabled</dt><dd>{ enabledLabel(monitor.Enabled) }</dd>
				<dt>Public</dt><dd>{ enabledLabel(monitor.Public) }</dd>
				<dt>Location</dt><dd><code>{ monitor.LocationId.String() }</code></dd>
				<dt>Required</dt><dd>{ enabledLabel(monitor.RequiredLocation) }</dd>
				<dt>Updated</dt><dd>{ formattedTime(monitor.UpdatedAt) }</dd>
			</dl>
			<a id="monitor-detail-close" class="xis-native-link" data-monitor-drawer-close data-monitor-id={ monitor.Id.String() } href={ templ.SafeURL(monitorURL(data.Query, data.Cursor, "")) } hx-get={ monitorURL(data.Query, data.Cursor, "") } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Close detail</a>
		</aside>
	</section>
}

templ ClearSearch() { @link.Link("/monitors", link.WithAppearance(link.AppearanceButton), link.WithRootClass("xis-primary-action"), link.WithAttrs(templ.Attributes{"hx-get": "/monitors", "hx-target": "#main-content", "hx-swap": "outerHTML", "hx-push-url": "true"})) { Clear search } }

templ NextPage(data MonitorList) {
	<a class="xis-native-link" href={ templ.SafeURL(monitorURL(data.Query, data.NextCursor, data.Selected)) } hx-get={ monitorURL(data.Query, data.NextCursor, data.Selected) } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" hx-indicator="#monitor-loading">Next page</a>
}

templ StatusPage(data sdk.PublicStatusPage) { @Document("Public status", PublicStatusShell(data)) }
templ StatusErrorPage(problem Problem) { @Document("Public status", PublicStatusErrorShell(problem)) }

templ PublicStatusErrorShell(problem Problem) {
	@navbar.Navbar(navbar.Config{Brand: Brand(), BrandHref: "/status", NavClass: "xis-public-nav", Links: []navbar.NavLink{{Label: "Public status", Href: "/status", Active: true}, {Label: "Administrator", Href: "/login"}}})
	@PublicStatusError(problem)
}

templ PublicStatusShell(data sdk.PublicStatusPage) {
	@navbar.Navbar(navbar.Config{Brand: Brand(), BrandHref: "/status", NavClass: "xis-public-nav", Links: []navbar.NavLink{{Label: "Public status", Href: "/status", Active: true}, {Label: "Administrator", Href: "/login"}}})
	@StatusContent(data)
}

templ StatusContent(data sdk.PublicStatusPage) {
	<main id="status-content" aria-live="polite" class="xis-content xis-stack">
		<div class="xis-status-header">
			@pageheader.PageHeader(pageheader.Config{Title: "X-9 status", Description: "Aggregate status for public monitors."})
			<a class="xis-native-link" href="/status" hx-get="/status" hx-target="#status-content" hx-swap="outerHTML" hx-indicator="#status-loading">Refresh</a>
		</div>
		<div id="status-loading" class="htmx-indicator xis-skeleton xis-results-surface" aria-live="polite">@skeleton.Skeleton(skeleton.Config{Label: "Refreshing public status", Count: 3, RootClass: "min-h-64"})</div>
		<div class="xis-status-results xis-stack">
			@alert.Alert(alert.Config{Title: publicStatusTitle(data.State), Description: "Generated " + formattedTime(data.GeneratedAt) + ".", Tone: healthTone(data.State), RootClass: healthStateClass(data.State)})
			if len(data.Monitors) == 0 {
				@emptystate.EmptyState(emptystate.Config{Title: "No public monitors", Description: "Public monitors will appear here after they are configured."})
			} else {
				<section aria-label="Public monitors">
					for _, monitor := range data.Monitors {
						<article id={ "monitor-" + monitor.Id.String() } class="xis-public-row">
							<div><h2>{ monitor.Name }</h2><p class="xis-meta">{ monitor.Description }</p></div>
							@healthBadge(monitor.State)
						</article>
					}
				</section>
			}
			if len(data.ActiveIncidents) > 0 {
				@alert.Alert(alert.Config{Title: "Active incidents", Description: fmt.Sprintf("%d incident(s) currently affect public monitors.", len(data.ActiveIncidents)), Tone: alert.ToneDanger, RootClass: "xis-state-danger"})
			}
		</div>
	</main>
}

templ PublicStatusError(problem Problem) {
	<main id="status-content" aria-live="polite" class="xis-content xis-stack">
		@pageheader.PageHeader(pageheader.Config{Title: "X-9 status", Description: "Aggregate status for public monitors."})
		@alert.Alert(alert.Config{Title: problem.Title, Description: problem.Detail, Tone: alert.ToneDanger, RootClass: "xis-state-danger"})
		<a class="xis-native-link" href="/status" hx-get="/status" hx-target="#status-content" hx-swap="outerHTML">Retry</a>
	</main>
}

templ ProblemPage(problem Problem) { @Document(problem.Title, ProblemContent(problem)) }
templ ShellProblemPage(csrfToken string, problem Problem) { @ShellPage(problem.Title, csrfToken, ShellProblemContent(problem)) }
templ ShellProblemContent(problem Problem) {
	<section id="problem-content" class="xis-content xis-stack" aria-labelledby="problem-heading">
		@pageheader.PageHeader(pageheader.Config{Title: problem.Title, Description: "The requested workspace is not available.", TitleAttrs: templ.Attributes{"id": "problem-heading"}})
		@alert.Alert(alert.Config{Title: problem.Title, Description: problem.Detail, Tone: alert.ToneDanger, RootClass: "xis-state-danger"})
		<div class="xis-meta"><p>Error code: <code>{ problem.Code }</code></p><p>Correlation ID: <code>{ problem.CorrelationID }</code></p></div>
		<a class="xis-native-link" href="/monitors" hx-get="/monitors" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Return to monitors</a>
	</section>
}
templ ProblemContent(problem Problem) {
	<main id="problem-content" class="xis-content xis-stack">
		@alert.Alert(alert.Config{Title: problem.Title, Description: problem.Detail, Tone: alert.ToneDanger, RootClass: "xis-state-danger"})
		<div class="xis-meta"><p>Error code: <code>{ problem.Code }</code></p><p>Correlation ID: <code>{ problem.CorrelationID }</code></p></div>
		<a class="xis-native-link" href="/login">Return to sign in</a>
	</main>
}

func monitorURL(query, cursor, selected string) string {
	values := url.Values{}
	if query != "" { values.Set("q", query) }
	if cursor != "" { values.Set("cursor", cursor) }
	if selected != "" { values.Set("selected", selected) }
	if encoded := values.Encode(); encoded != "" { return "/monitors?" + encoded }
	return "/monitors"
}

func searchResultURL(item sdk.SearchResult) string {
	if item.ResourceType == sdk.SearchResourceTypeMonitor {
		return monitorURL("", "", item.ResourceId.String())
	}
	return "/monitors"
}

func monitorTable(data MonitorList) table.Config {
	rows := make([]table.Row, 0, len(data.Monitors))
	for _, monitor := range data.Monitors {
		id := monitor.Id.String()
		health := data.Health[id]
		state := health.State
		if state == "" { state = sdk.Unknown }
		name := monitor.Name
		selected := data.Selected == id
		attrs := map[string]string{"data-monitor-id": id, "aria-selected": fmt.Sprint(selected)}
		rows = append(rows, table.Row{ID: id, HTMX: &table.RowHTMXConfig{Get: monitorURL(data.Query, data.Cursor, id), Target: "#main-content", Swap: "outerHTML", PushURL: true}, AlpineAttrs: attrs, Cells: map[string]table.Cell{
			"name": {Text: name}, "kind": {Text: strings.ToUpper(string(monitor.Kind))}, "health": {Component: healthBadge(state)}, "enabled": {Text: enabledLabel(monitor.Enabled)},
		}})
	}
	return table.Config{ID: "monitor-table", Caption: "Configured monitors and current health", Columns: []table.Column{{Key: "name", Label: "Monitor"}, {Key: "kind", Label: "Kind"}, {Key: "health", Label: "Health"}, {Key: "enabled", Label: "Enabled"}}, Rows: rows}
}

func selectedMonitor(data MonitorList) (sdk.Monitor, sdk.MonitorHealth, bool) {
	for _, monitor := range data.Monitors {
		if monitor.Id.String() != data.Selected { continue }
		health := data.Health[data.Selected]
		if health.State == "" { health = sdk.MonitorHealth{MonitorId: monitor.Id, State: sdk.Unknown} }
		return monitor, health, true
	}
	return sdk.Monitor{}, sdk.MonitorHealth{}, false
}

func enabledLabel(enabled bool) string { if enabled { return "Yes" }; return "No" }

func healthBadge(state sdk.HealthState) templ.Component {
	tone := badge.ToneDefault
	switch state { case sdk.Up: tone = badge.ToneSuccess; case sdk.Down: tone = badge.ToneDanger; case sdk.Degraded: tone = badge.ToneWarning; case sdk.Pending: tone = badge.ToneInfo }
	return badge.Badge(badge.Config{Label: strings.ToUpper(string(state)), Tone: tone, Appearance: badge.AppearanceSoft, Indicator: true, RootClass: "xis-status-badge " + healthStateClass(state)})
}

func healthStateClass(state sdk.HealthState) string {
	switch state { case sdk.Up: return "xis-state-success"; case sdk.Degraded: return "xis-state-warning"; case sdk.Down: return "xis-state-danger"; default: return "xis-state-info" }
}

func healthTone(state sdk.HealthState) alert.Tone {
	switch state { case sdk.Up: return alert.ToneSuccess; case sdk.Down: return alert.ToneDanger; case sdk.Degraded: return alert.ToneWarning; default: return alert.ToneInfo }
}

func publicStatusTitle(state sdk.HealthState) string {
	switch state { case sdk.Up: return "All public systems operational"; case sdk.Down: return "Public systems disrupted"; case sdk.Degraded: return "Some public systems degraded"; case sdk.Pending: return "Public status pending"; default: return "Public status unknown" }
}

func formattedTime(value time.Time) string { if value.IsZero() { return "time unavailable" }; return value.UTC().Format("2 Jan 2006 15:04 UTC") }
